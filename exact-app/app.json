{
  "$schema": ".exact/checkout/scripts/app.schema.json",
  "name": "Good Time",
  "short_name": "Good Time",
  "id": "com.alikimovich.good-time-to-sleep",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f3f4",
  "color_scheme_dark": {
    "background_color": "#14110f"
  },
  "audio_session": "playback",
  "app": {
    "id": "com.alikimovich.good-time-to-sleep",
    "name": "Good Time"
  },
  "host": {
    "web": {},
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ],
      "link": [
        "-Xlinker",
        "-weak_framework",
        "-Xlinker",
        "AlarmKit"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0",
      "macos": "0"
    }
  },
  "icons": [
    {
      "src": "assets/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }
  ],
  "strings": {
    "base": "en"
  },
  "forma": "app.forma"
}
