// Good Time: the view. app.ts does the sleep-cycle math and writes the times.
// Ported from the SwiftUI app in ../good-time: an intro shown until the person moves on,
// then two tabs (Wake Up, Bed Time), each pushing Settings. Colours are the asset catalog's,
// in app.forma; strings are good-time/*.lproj's, in strings/.
shape Time
  epochAtZero: number
  utcOffset: number
  formatLocale: string
  timeZone: string

shape Row
  cycles: number
  time: string
  // The wall clock, "HH:MM": what a wake-up alarm is set from.
  hhmm: string
  progress: number

shape Schedule
  wakeUpTime: string
  wake: Row[]
  bed: Row[]

shape Media
  prefersReducedMotion: bool

// The wake-up alarm (LKM-696), as app.ts reads modules/apple/WakeAlarm.swift: AlarmKit's on iOS 26
// and later, `available` false elsewhere. `label` is its day and time; `error` what the last tap
// ran into (unsupported, denied, invalid, busy, failed).
shape AlarmView
  available: bool
  auth: string
  scheduled: bool
  at: number
  label: string
  time: string
  hhmm: string
  error: string
  // An error worth a message (not a busy tap, not the denied card's own case).
  showError: bool
  // The sound the scheduled alarm rings with: "default" (the system's) or a tone's id; "" unscheduled.
  sound: string

// Good Time's own alarm tones (tools/alarm-tones.mjs makes them): previewed on a tap only, and
// given to AlarmKit by name (WakeAlarm.swift). There is no API to the Clock app's ringtones or music.
sound "assets/sounds/alarm-sunrise.wav"
sound "assets/sounds/alarm-chime.wav"
sound "assets/sounds/alarm-pulse.wav"

// Motion (LKM-651, LKM-703). Every animation and transition below is gated on `still` (the
// system's Reduce Motion): with it on, the screens change and the controls move without motion.
// Rows, labels and "Recommended" appear in place at once; the only content entrance is the
// cycle bars filling (`fill`), once each time a result screen is shown.
// A cycle bar's fill sliding in from the track's leading edge to its fraction (it is clipped by
// the track, so its first frame is an empty track).
keyframes fill
  from translate="-100% 0px"
// The intro leaving: it fades and drifts left, the way the arrow and the swipe point.
keyframes introLeave
  to opacity=0 translate="-48px 0px" animation-timing-function="ease-in"

routes nav
  tab wakeup "/"
    settings "/settings"
  tab bedtime "/bedtime"

// The colour of a row's time: 6 cycles is TextColor1, 3 cycles TextColor4 (`Color("TextColor\(7 - cycles)")`).
fn tone(cycles: number): string = `gt.text${7 - cycles}`
// A bar's fraction, held to 0–1.
fn share(p: number): number = p > 0 ? min(1, p) : 0

// A screen's title (Wake Up, Bed Time, Settings; LKM-697, LKM-707): New York italic. Only family
// and style are said, so each keeps the platform title's size, weight and Dynamic Type, and a
// level-1 heading stays iOS's large title.
style ScreenTitle
  font-family = "ui-serif, serif"
  font-style = "italic"
// The title's words with a no-break space and a word joiner after them (LKM-707). UIKit's large
// title sizes its label to the words' advance, so an italic's last glyph, which leans past it, was
// cut ("Up"'s p). The space gives that ink room; UIKit drops a trailing space of any kind from the
// label's width, so the word joiner (zero width, not a space) keeps it from trailing. Both are
// no-break, so the title never wraps on them; they stay out of the strings (en, es, ru), which
// keep the bare title, and VoiceOver says nothing for them.
fn screenTitle(words: string): string = `${words}\u{00A0}\u{2060}`

component GoodTime
  state showIntro = true persist
  state timeToFallAsleep = 15 persist
  state sleepCycleLength = 90 persist
  state wakeUpTime = "08:00" persist
  state bedtimeAutoReminders = false persist
  state now = 0
  // A spring "bump" on a time picker and the times it moves, for a moment after a new time is picked.
  state picked = 0
  state bumping = false
  resource media = exactViewport() as shape Media
  derive still = media.prefersReducedMotion
  resource time = exactTime() as shape Time
  // The clock goes after `with`: it reaches app.ts but does not identify the answer, so a launch
  // shows the last answer at once and replaces it when app.ts answers for now.
  resource times = schedule(time.utcOffset, wakeUpTime, timeToFallAsleep, sleepCycleLength,
    time.formatLocale, time.timeZone) with time.epochAtZero + now as shape Schedule

  // The app's one wake-up alarm. A set or a cancel answers the alarm the system now holds; the
  // view shows a time only from that answer, never before it.
  resource alarm = wakeAlarm(time.formatLocale, time.timeZone) as shape AlarmView
  mutation alarmSet as shape AlarmView refreshes alarm then alarmAnswered
  mutation alarmCancelled as shape AlarmView refreshes alarm then alarmCleared
  state alarmError = false
  // The alarm's sound, kept across launches: "default" or a tone's id (app.ts ALARM_SOUNDS).
  state alarmSound = "default" persist
  derive alarmBusy = pending(alarmSet) or pending(alarmCancelled)

  task tick mount
    every(30000, step)
  action step
    now = performanceNow()
  task unbump when bumping key=picked
    after(140, settle)
  action settle
    bumping = false

  action begin
    showIntro = false
    now = performanceNow()
  action pick(name: string)
    stopSounds(group="alarm-preview")
    nav = select(nav, name)
  // Leaving Settings (back, a link, a tab) stops a sound preview still playing there.
  action follow(url: string)
    stopSounds(group="alarm-preview")
    nav = go(nav, url)
  action back
    stopSounds(group="alarm-preview")
    nav = back(nav)
  action openSettings
    nav = push(nav, path("settings"))
  action setFallAsleep(v: string)
    timeToFallAsleep = match parseNumber(v) { case some(n) => n, case none => timeToFallAsleep }
  action setCycle(v: string)
    sleepCycleLength = match parseNumber(v) { case some(n) => n, case none => sleepCycleLength }
  // Asks for AlarmKit's permission on the first tap; the next `hhmm` after now, in this time zone.
  action setAlarm(hhmm: string)
    alarmError = false
    send alarmSet = setWakeAlarm(hhmm, time.timeZone, t("alarm.title"), t("alarm.stop"),
      time.epochAtZero + performanceNow(), time.formatLocale, alarmSound)
  // A new sound for a set alarm sets it again, same time, with that sound (replacing it only once
  // the new one is scheduled); unset, it is the next alarm's sound.
  action chooseSound(v: string)
    alarmSound = v
    if alarm.scheduled and alarm.sound != v and not alarmBusy
      alarmError = false
      send alarmSet = setWakeAlarm(alarm.hhmm, time.timeZone, t("alarm.title"), t("alarm.stop"),
        time.epochAtZero + performanceNow(), time.formatLocale, v)
  // Only on a tap; under the agent nothing plays (the runner records it).
  action previewSound
    stopSounds(group="alarm-preview")
    if alarmSound != "default"
      playSound(`assets/sounds/alarm-${alarmSound}.wav`, group="alarm-preview")
  action alarmAnswered
    alarmError = match alarmSet { case some(r) => r.showError, case none => false }
  action cancelAlarm
    alarmError = false
    send alarmCancelled = cancelWakeAlarm(time.formatLocale, time.timeZone)
  action alarmCleared
    alarmError = match alarmCancelled { case some(r) => r.showError, case none => false }
  action openAppSettings
    openURL("app-settings:")
  action setWakeUp(v: string)
    if v != ""
      wakeUpTime = v
      picked = picked + 1
      bumping = not still

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="root"
      width="100%" height="100%" display="flex" flex-direction="column" background-color="gt.background"
      column flex=1 min-height=0 position="relative"
        for tb in nav.tabs key=tb.name
          // A tab's panel shows at once (LKM-703: no fade or slide of the rows in it).
          column role="tabpanel" id=`panel-${tb.name}` position="absolute" inset=0
            opacity=(nav.tab == tb.name ? 1 : 0)
            for e in tb.stack key=e.id
              if e.name == "wakeup"
                if showIntro
                  column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0
                    background-color="gt.background" testId="intro"
                    -exact-exit-animation=(still ? "none" : "introLeave 240ms ease-in both")
                    scroll flex=1 min-height=0
                      column swipeleft=begin touch-action="pan-y" max-width="25.875rem" testId="intro-swipe" padding="40px 32px" gap=60
                        box-sizing="border-box"
                        text t("intro.title") font-family="ui-serif, serif" font-size="2.5rem" line-height=1.37
                          white-space="pre-line" overflow-wrap="break-word" color="gt.highlight" role="heading" aria-level=1 testId="intro-title"
                        column gap=30 align-items="flex-start"
                          text t("intro.subtitle") font-family="ui-serif, serif" font-size="2.5rem" line-height=1.32
                            color="gt.highlight" testId="intro-subtitle"
                          button press=begin appearance="none" aria-label=t("intro.continue") testId="intro-continue"
                            :active
                              -exact-press-scale=(still ? 1 : 0.88)
                            text "⟼" font-family="ui-serif, serif" font-size="4rem" color="gt.highlight" aria-hidden=true
                else
                  column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                    display="flex" flex-direction="column" background-color="gt.background"
                    header display="flex" align-items="center"
                      text screenTitle(t("wakeup.title")) class=ScreenTitle role="heading" aria-level=1 flex=1
                        testId="wakeup-title"
                      button press=openSettings aria-label=t("settings.title") testId="wakeup-settings"
                        :active
                          -exact-press-scale=(still ? 1 : 0.85)
                        image "symbol:icon.settings"
                    scroll id=`content-${e.id}` flex=1 min-height=0
                      column padding-bottom=32
                        text t("wakeup.header") font-size="1.125rem" color="gt.highlight" padding="0px 16px 16px"
                          testId="wakeup-header"
                        Times(rows=times.wake, best=true, prefix="wake", fill=(not still and nav.tab == "wakeup"),
                          alarms=alarm.available, busy=alarmBusy, setAlarm=setAlarm)
                        AlarmStatus(alarm=alarm, error=alarmError, busy=alarmBusy, cancel=cancelAlarm,
                          settings=openAppSettings, prefix="wakeup")
                        text t("wakeup.footer") font-size="1rem" color="gt.text2" padding=16 margin="16px 16px 0px"
                          background-color="gt.card" border-radius=20 testId="wakeup-footer"
              if e.name == "bedtime"
                column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position="absolute" inset=0
                  display="flex" flex-direction="column" background-color="gt.background"
                  header display="flex" align-items="center"
                    text screenTitle(t("bedtime.title")) class=ScreenTitle role="heading" aria-level=1 flex=1
                      testId="bedtime-title"
                    button press=openSettings aria-label=t("settings.title") testId="bedtime-settings"
                      :active
                        -exact-press-scale=(still ? 1 : 0.85)
                      image "symbol:icon.settings"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    column padding-bottom=16
                      // The subtitle is the wake-time control (LKM-724): its words, then the picker where the
                      // time was, then (with alarms) an icon-only alarm button on the content's trailing edge,
                      // as Wake Up's rows have. The line is as tall as its text, as the static subtitle was:
                      // the picker's pill (36 points) gives back 7 points above and below (negative margins),
                      // and the button is placed over the line (absolute, centred, 44×44), so neither moves
                      // the subtitle or the rows. Its icon ends on the content edge, as Wake Up's do; its hit
                      // area reaches across the 16-point screen margin, so the line keeps only 28 points of
                      // room for it and the words, an "10:30 AM" picker and the button fit one line on a
                      // 375-point iPhone. Where there is no room (large text, a long translation on a narrow
                      // screen) the picker wraps under the words.
                      column padding="0px 16px 16px" testId="bedtime-header"
                        row position="relative" align-items="center" flex-wrap="wrap" column-gap=4 row-gap=8
                          padding-right=(alarm.available ? 28 : 0)
                          text t("bedtime.header_lead") font-size="1.125rem" color="gt.highlight" min-width=0
                            testId="bedtime-header-lead"
                          input type="time" value=wakeUpTime change=setWakeUp aria-label=t("bedtime.datepicker_title")
                            testId="bedtime-wake" margin="-7px 0px" scale=(bumping ? 1.08 : 1)
                            transform-origin="left center"
                            transition=(still ? "none" : "scale -exact-spring(420, 16, 1)")
                          if alarm.available
                            button press=setAlarm(wakeUpTime) disabled=alarmBusy
                              aria-label=t("alarm.set_for", time=times.wakeUpTime) appearance="none"
                              position="absolute" right=-16 top="50%" translate="0px -50%" width=44 height=44
                              padding="0px 16px 0px 0px" box-sizing="border-box" display="flex" align-items="center"
                              justify-content="flex-end"
                              testId="bedtime-alarm"
                              image "symbol:icon.alarm" color="gt.highlight"
                      Times(rows=times.bed, best=false, prefix="bed", fill=(not still and nav.tab == "bedtime"),
                        alarms=false, busy=alarmBusy, setAlarm=setAlarm)
                      AlarmStatus(alarm=alarm, error=alarmError, busy=alarmBusy, cancel=cancelAlarm,
                        settings=openAppSettings, prefix="bedtime")
              if e.name == "settings"
                // The app's own ground, as Wake Up and Bed Time have (LKM-707): unsaid, a grouped
                // list's route and the list around its cards are the system's grouped grey. The
                // cards (the rows) keep their own grouped surface.
                column navigationKey=`${e.id}` navigationScroll=`form-${e.id}` position="absolute" inset=0
                  display="flex" flex-direction="column" background-color="gt.background"
                  header
                    text screenTitle(t("settings.title")) class=ScreenTitle role="heading" aria-level=1
                      testId="settings-title"
                  list id=`form-${e.id}` appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    background-color="gt.background" testId="settings"
                    section
                      header
                        text t("settings.section.sleep_details")
                      row
                        text t("settings.time_to_fall_asleep")
                        select value=`${timeToFallAsleep}` change=setFallAsleep
                          aria-label=t("settings.time_to_fall_asleep") testId="fall-asleep"
                          for m in range(12).map(i => 5 + i * 5) key=m
                            option t("settings.minute", count=`${m}`) value=`${m}`
                      row
                        text t("settings.sleep_cycle_length")
                        select value=`${sleepCycleLength}` change=setCycle
                          aria-label=t("settings.sleep_cycle_length") testId="cycle-length"
                          for m in range(11).map(i => 70 + i * 5) key=m
                            option t("settings.minute", count=`${m}`) value=`${m}`
                    section
                      header
                        text t("settings.section.wake_up")
                      row
                        text t("settings.wake_up_time")
                        input type="time" value=wakeUpTime change=setWakeUp aria-label=t("settings.wake_up_time")
                          testId="settings-wake"
                    // The alarm's sound (LKM-698): chosen and previewed here, kept across launches. An alarm
                    // itself is set from a time's alarm button on Wake Up or Bed Time, as the footer says.
                    section testId="settings-alarm"
                      header
                        text t("settings.section.alarm")
                      if alarm.available
                        row
                          text t("alarm.sound")
                          select value=alarmSound change=chooseSound disabled=alarmBusy aria-label=t("alarm.sound")
                            testId="settings-alarm-sound"
                            option t("alarm.sound.default") value="default"
                            option t("alarm.sound.sunrise") value="sunrise"
                            option t("alarm.sound.chime") value="chime"
                            option t("alarm.sound.pulse") value="pulse"
                        // Preview is the row itself (LKM-714), a grouped list's button row: UIKit's own cell,
                        // whose title starts at the cell's margin as Sound's label does. A button inside a
                        // `row` is a UIButton in a custom cell and adds its own content inset before the text.
                        if alarmSound != "default"
                          button press=previewSound aria-label=t("alarm.preview_of", sound=(alarmSound == "sunrise" ? t("alarm.sound.sunrise") : (alarmSound == "chime" ? t("alarm.sound.chime") : (alarmSound == "pulse" ? t("alarm.sound.pulse") : t("alarm.sound.default")))))
                            testId="settings-alarm-preview"
                            text t("alarm.preview") color="AccentColor"
                      footer
                        // A sound change that could not re-set a scheduled alarm says so beside the picker.
                        text (not alarm.available ? t("alarm.unsupported") : ((alarmError or alarm.showError) ? `${t("alarm.failed")} ${t("alarm.settings_hint")} ${t("alarm.sound_note")}` : `${t("alarm.settings_hint")} ${t("alarm.sound_note")}`))
                          testId="settings-alarm-note"
      row role="tablist" display=(showIntro ? "none" : "flex")
        button role="tab" aria-controls="panel-wakeup" aria-selected=(nav.tab == "wakeup") press=pick("wakeup")
          testId="tab-wakeup" flex=1
          :active
            -exact-press-scale=(still ? 1 : 0.92)
          image "symbol:icon.sunrise" scale=(nav.tab == "wakeup" ? 1.15 : 1)
            transition=(still ? "none" : "scale -exact-spring(380, 20, 1)")
          text t("tab.wakeup")
        button role="tab" aria-controls="panel-bedtime" aria-selected=(nav.tab == "bedtime") press=pick("bedtime")
          testId="tab-bedtime" flex=1
          :active
            -exact-press-scale=(still ? 1 : 0.92)
          image "symbol:icon.bedtime" scale=(nav.tab == "bedtime" ? 1.15 : 1)
            transition=(still ? "none" : "scale -exact-spring(380, 20, 1)")
          text t("tab.bedtime")

component Times
  props
    rows: Row[]
    best: bool
    prefix: string
    // The bars fill in (LKM-703): this screen is the one shown and Reduce Motion is off. It turns
    // on when the screen is shown, which starts the fill once; while it stays on, a new time or
    // the clock changes the rows in place and the bars keep their fractions.
    fill: bool
    // Each row sets a wake-up alarm at its time (where the device has alarms).
    alarms: bool
    busy: bool
    setAlarm: action
  view
    column
      // Keyed by cycles only, so a new time or a clock tick updates a row in place, never remounts it.
      for r in rows key=`${r.cycles}`
        column padding="8px 16px" testId=`${prefix}-${r.cycles}`
          text t("wakeup.cycles", count=`${r.cycles}`) font-size="0.875rem" font-weight=600 color="gt.text4"
            testId=`${prefix}-${r.cycles}-cycles`
          // The time line (LKM-713): the time, then "Recommended" beside it on its baseline (on the
          // next line when there is no room, as at the largest text sizes). It is as tall as its text
          // on both tabs, so a row's label, time and bar sit as Bed Time's do. The alarm button is
          // placed over the line's trailing edge, centred on it, and the line keeps room for it: its
          // 44-point hit area never makes the line taller.
          row position="relative" align-items="baseline" flex-wrap="wrap" column-gap=8
            padding-right=(alarms ? 52 : 0)
            text r.time font="-exact-title1" font-weight=700 color=tone(r.cycles) min-width=0
              overflow-wrap="break-word" testId=`${prefix}-${r.cycles}-time`
            if best and r.cycles == 5
              text t("wakeup.recommended") font-family="ui-serif, serif" font-style="italic" font-size="1.125rem"
                color="gt.highlight" testId=`${prefix}-best`
            if alarms
              button press=setAlarm(r.hhmm) disabled=busy aria-label=t("alarm.set_for", time=r.time)
                appearance="none" position="absolute" right=0 top="50%" translate="0px -50%"
                width=44 height=44 padding=0 display="flex"
                align-items="center" justify-content="flex-end" testId=`${prefix}-${r.cycles}-alarm`
                image "symbol:icon.alarm" color="gt.highlight"
          // The cycle bar, drawn as UIProgressView draws one (a 4-point capsule track, the fill in
          // the row's tone) so its fill can ease in: the native bar's own easing is UIKit's and is
          // skipped on first show. The fill's width is its fraction at once; only its translate moves.
          view role="progressbar" aria-label=t("wakeup.cycles", count=`${r.cycles}`)
            aria-valuenow=`${round(share(r.progress) * 100)}` aria-valuemin="0" aria-valuemax="100"
            height=4 border-radius=2 margin="8px 0px" width="100%" overflow="hidden" background-color="-exact-fill"
            testId=`${prefix}-${r.cycles}-bar`
            view width=`${share(r.progress) * 100}%` height="100%" border-radius=2
              background-color=tone(r.cycles) testId=`${prefix}-${r.cycles}-fill`
              animation=(fill ? "fill 300ms cubic-bezier(0.23, 1, 0.32, 1) both" : "none")

// The wake-up alarm's state, on both tabs: where it is set and for when (the system's answer), or
// why it is not. It says plainly that the alarm is Good Time's, not the Clock app's. The sound is
// chosen in Settings (LKM-698); with nothing to report, only a one-line hint stays here.
component AlarmStatus
  props
    alarm: AlarmView
    error: bool
    busy: bool
    cancel: action
    settings: action
    prefix: string
  view
    column
      if alarm.available and not alarm.scheduled and alarm.auth != "denied"
        text t("alarm.hint") font-size="0.8125rem" color="gt.text3" padding="8px 16px 0px"
          testId=`${prefix}-alarm-hint`
      if not alarm.available or alarm.scheduled or alarm.auth == "denied" or error or alarm.showError
        column gap=8 padding=16 margin="16px 16px 0px" background-color="gt.card" border-radius=20
          testId=`${prefix}-alarm-card`
          if not alarm.available
            text t("alarm.unsupported") font-size="0.9375rem" color="gt.text2" testId=`${prefix}-alarm-unsupported`
          else
            if alarm.scheduled
              row align-items="center" gap=8
                image "symbol:icon.alarm" color="gt.highlight" aria-hidden=true
                text t("alarm.scheduled", date=alarm.label) font-size="1rem" font-weight=600 color="gt.highlight" flex=1
                  testId=`${prefix}-alarm-scheduled`
              text t("alarm.sound_of", sound=(alarm.sound == "sunrise" ? t("alarm.sound.sunrise") : (alarm.sound == "chime" ? t("alarm.sound.chime") : (alarm.sound == "pulse" ? t("alarm.sound.pulse") : t("alarm.sound.default"))))) font-size="0.9375rem" color="gt.text2"
                testId=`${prefix}-alarm-sound-scheduled`
              text t("alarm.owned") font-size="0.8125rem" color="gt.text3"
              button press=cancel disabled=busy testId=`${prefix}-alarm-cancel`
                text t("alarm.cancel")
            else if alarm.auth == "denied"
              text t("alarm.denied") font-size="0.9375rem" color="gt.text2" testId=`${prefix}-alarm-denied`
              button press=settings testId=`${prefix}-alarm-settings`
                text t("alarm.open_settings")
            if error or alarm.showError
              text t("alarm.failed") font-size="0.9375rem" color="gt.text2" role="alert" testId=`${prefix}-alarm-failed`
