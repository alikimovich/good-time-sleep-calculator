#!/usr/bin/env bash
# LKM-771: drafts the App Store version of the Exact app; never submits it for review.
#   scripts/appstore-prepare           # create or reuse the version in release.json, upload fastlane/metadata and
#                                      # fastlane/screenshots, set the URLs, attach the newest VALID build, manual release
#   scripts/appstore-prepare --state   # only read back what App Store Connect has for that version
# Both print the read-back as JSON. Submitting for review stays Andrei's action in App Store Connect.
# The API key comes from the release config outside the repository (docs/release.md).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

lane="appstore_prepare"
case "${1:-}" in
  "") ;;
  --state) lane="appstore_state" ;;
  *) fail "usage: scripts/appstore-prepare [--state]" ;;
esac

config="${GT_RELEASE_CONFIG:-$HOME/.appstoreconnect/good-time.json}"
[[ -f "$config" ]] || fail "no release config at $config (docs/release.md)"
require jq "brew install jq"
require fastlane "brew install fastlane"

GT_ASC_KEY_ID="$(jq -r '.key_id' "$config")"
GT_ASC_ISSUER_ID="$(jq -r '.issuer_id' "$config")"
GT_ASC_KEY_PATH="$(jq -r '.key_path' "$config")"
GT_ASC_KEY_PATH="${GT_ASC_KEY_PATH/#\~/$HOME}"
export GT_ASC_KEY_ID GT_ASC_ISSUER_ID GT_ASC_KEY_PATH
export FASTLANE_SKIP_UPDATE_CHECK=1 FASTLANE_HIDE_CHANGELOG=1

version="$(jq -r '.marketing_version' "$ROOT/release.json")"
out="$(mktemp -t good-time-appstore).json"
step "fastlane ios $lane version:$version"
(cd "$ROOT" && fastlane ios "$lane" "version:$version" "output:$out")
cat "$out"
